Items: {
	SakuraKatana: {
		DisplayName: Sakura Katana
		Tooltip:
			'''
			Hold left click for a three-cut combo. Right click releases a flowering crescent.
			Carry in your hotbar to wear the blade and scatter petals.
			'''
	}

	EmberSniper: {
		DisplayName: Ember Longshot
		Tooltip: Charges for 0.4 seconds. Distant hits deal up to double damage. Recharges in 8 seconds.
	}

	EmberShotgun: {
		DisplayName: Ember Pump
		Tooltip:
			'''
			Fires seven energy pellets. Each hit fractures 1% of defense for 4 seconds (up to 30%).
			Recharges in 5 seconds, even when holstered.
			'''
	}

	qwe: {
		DisplayName: qwe
		Tooltip:
			'''
			Template of an item
			Replacing this tooltip is duty 
			It's snowing on Mt.Fuji
			'''
	}

	smg: {
		DisplayName: smg
		Tooltip: ""
	}
}

Sakura.ParticleDiagnostics: Sakura   {0} active   +{1}/frame   {2} skipped   update {3} ms   draw {4} ms

Configs: {
	SakuraVisualConfig: {
		DisplayName: Sakura effects

		Quality: {
			Label: Quality
			Tooltip: Controls petal density, emission frequency and lifetime.
		}

		ParticleLimit: {
			Label: Particle limit
			Tooltip: Maximum number of live decorative particles across all players.
		}

		SpawnBudget: {
			Label: Particles per frame
			Tooltip: Maximum new particles shared by all emitters in a rendered frame.
		}

		AuraLimit: {
			Label: Aura per player
			Tooltip: Maximum number of aura particles attached to each player.
		}

		Diagnostics: {
			Label: Diagnostics
			Tooltip: Show particle counts and CPU time spent updating and submitting draws.
		}
	}

